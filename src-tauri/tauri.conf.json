{
  "productName": "D2MXLUtils",
  "version": "1.26.24",
  "identifier": "com.d2mxlutils.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/sounds/*"]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "D2MXLUtils",
        "width": 1040,
        "height": 740,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "overlay",
        "title": "D2MXLUtils Overlay",
        "width": 800,
        "height": 600,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {}
}



